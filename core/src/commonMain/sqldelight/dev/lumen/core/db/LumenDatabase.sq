-- Lumen database schema — FROZEN at M1.
-- Normative spec: docs/data-model.md. Migrations are additive-only.
-- Any change to this file after M1 requires a tag-bump PR reviewed by
-- both agents (docs/plan.md, Two-Agent Execution Contract).

CREATE TABLE devices (
    device_id        TEXT PRIMARY KEY,      -- uuid v4
    display_name     TEXT NOT NULL,
    public_key_x25519 BLOB NOT NULL,
    created_at_ms    INTEGER NOT NULL,
    last_seen_ms     INTEGER
);

CREATE TABLE events (                       -- pruned ~30 days
    device_id        TEXT NOT NULL REFERENCES devices(device_id),
    seq              INTEGER NOT NULL,      -- per-device monotonic (device B's seq 1 is independent of device A's seq 1)
    app_key          TEXT NOT NULL,
    title_hash       TEXT,                  -- truncated/hashed, NEVER synced
    started_at_ms    INTEGER NOT NULL,
    duration_ms      INTEGER NOT NULL,
    category         TEXT,                  -- denormalized snapshot
    sync_state       INTEGER NOT NULL DEFAULT 0,  -- 0 local, 1 acked, 2 conflict
    PRIMARY KEY (device_id, seq)
);

CREATE INDEX idx_events_device_seq ON events(device_id, seq);

CREATE TABLE buckets (                      -- pruned ~6 months
    device_id   TEXT NOT NULL,
    bucket_ts   INTEGER NOT NULL,           -- UTC minute boundary (ms)
    app_key     TEXT NOT NULL,
    active_ms   INTEGER NOT NULL,
    PRIMARY KEY (device_id, bucket_ts, app_key)
);

CREATE TABLE rollups (                      -- kept forever
    device_id  TEXT NOT NULL,
    day_utc    TEXT NOT NULL,               -- 'YYYY-MM-DD' UTC day
    app_key    TEXT NOT NULL,
    total_ms   INTEGER NOT NULL,
    category   TEXT,
    PRIMARY KEY (device_id, day_utc, app_key)
);

CREATE TABLE settings (                     -- LWW + UTC-day reconciliation
    key             TEXT PRIMARY KEY,
    value           BLOB NOT NULL,
    updated_at_ms   INTEGER NOT NULL,
    updated_day_utc TEXT NOT NULL,
    device_id       TEXT NOT NULL           -- last writer
);

CREATE TABLE category_registry (
    app_key  TEXT PRIMARY KEY,
    category TEXT NOT NULL,
    source   TEXT NOT NULL                  -- 'registry' | 'manual'
);

CREATE TABLE manual_overrides (
    app_key       TEXT PRIMARY KEY,
    category      TEXT NOT NULL,
    created_at_ms INTEGER NOT NULL,
    sticky        INTEGER NOT NULL DEFAULT 1 -- never auto-reclassified
);

CREATE TABLE sync_watermark (
    device_id      TEXT PRIMARY KEY,
    last_acked_seq INTEGER NOT NULL
);

-- Control-state takeover (docs/data-model.md "two devices at once" rule).
-- The device that last declared itself the active controller owns the
-- state until a newer declaration supersedes it. Tiebreak (device_id, seq),
-- NEVER wall-clock — two skewed clocks must not flip-flop ownership.
CREATE TABLE control_state (
    control_key   TEXT PRIMARY KEY,        -- 'focus_session' | 'limit' | 'nudge'
    device_id     TEXT NOT NULL,
    device_seq    INTEGER NOT NULL,        -- monotonic per device; the tiebreak
    started_at_ms INTEGER NOT NULL,        -- display hint only, never the tiebreak
    utc_day       TEXT NOT NULL,
    released      INTEGER NOT NULL DEFAULT 0  -- 0=active, 1=explicitly released
);

-- Local-day rollups (discussion #29). The UTC `rollups` table above stays
-- the reconciliation/sync unit; this one is what the UI reads, so a user at
-- UTC-4 does not watch "Today" reset at 20:00 local.
--
-- Keyed by the day boundary of the `display.timezone` SETTING, not by each
-- device's OS zone — otherwise two devices in different places disagree about
-- which day a session belongs to and their totals cannot be summed, which is
-- the exact failure the UTC rule exists to prevent.
--
-- `utc_offset_min` records the offset in force when the row was written. A day
-- lived in EDT is a historical fact; relocating should not silently redraw it.
--
-- Derived and per-device: never synced. Devices exchange raw events and each
-- derives its own view, per RollupEngine's contract.
CREATE TABLE rollups_local (
    device_id      TEXT NOT NULL,
    day_local      TEXT NOT NULL,           -- 'YYYY-MM-DD' in display.timezone
    app_key        TEXT NOT NULL,
    total_ms       INTEGER NOT NULL,
    utc_offset_min INTEGER NOT NULL,
    category       TEXT,
    PRIMARY KEY (device_id, day_local, app_key)
);

-- Queries used by the storage layer (Agent A). Names are contract —
-- the storage API is part of the frozen surface.

selectAllRollups:
SELECT * FROM rollups WHERE device_id = ? AND day_utc = ?;

selectBucketsForDay:
SELECT * FROM buckets WHERE device_id = ? AND bucket_ts >= ? AND bucket_ts < ?;

insertEvent:
INSERT OR IGNORE INTO events(seq, device_id, app_key, title_hash, started_at_ms, duration_ms, category, sync_state)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

insertBucket:
INSERT OR REPLACE INTO buckets(device_id, bucket_ts, app_key, active_ms)
VALUES (?, ?, ?, ?);

upsertRollup:
INSERT OR REPLACE INTO rollups(device_id, day_utc, app_key, total_ms, category)
VALUES (?, ?, ?, ?, ?);

upsertSetting:
INSERT OR REPLACE INTO settings(key, value, updated_at_ms, updated_day_utc, device_id)
VALUES (?, ?, ?, ?, ?);

insertManualOverride:
INSERT OR REPLACE INTO manual_overrides(app_key, category, created_at_ms, sticky)
VALUES (?, ?, ?, 1);

selectAppKeyCategory:
SELECT category FROM category_registry WHERE app_key = ?;

selectManualOverride:
SELECT category FROM manual_overrides WHERE app_key = ?;

selectSetting:
SELECT * FROM settings WHERE key = ?;

selectWatermark:
SELECT last_acked_seq FROM sync_watermark WHERE device_id = ?;

upsertWatermark:
INSERT OR REPLACE INTO sync_watermark(device_id, last_acked_seq)
VALUES (?, ?);

selectEventsAfter:
SELECT * FROM events WHERE device_id = ? AND seq > ? ORDER BY seq;

markEventSynced:
UPDATE events SET sync_state = ? WHERE device_id = ? AND seq = ?;

pruneEventsBefore:
DELETE FROM events WHERE started_at_ms < ?;

pruneBucketsBefore:
DELETE FROM buckets WHERE bucket_ts < ?;

-- Derived-data rebuild: buckets and rollups are DERIVED from events (M1
-- contract: "buckets/rollups are DERIVED, never synced"). Clearing them
-- per device lets the app re-derive from honest events when derived rows
-- have drifted (e.g. written by a pre-fix binary). Events are untouched.
-- NOTE: SQLDelight generates ONE statement per query — the rollup delete
-- lives in its own query or it silently never runs.
clearBucketsForDevice:
DELETE FROM buckets WHERE device_id = ?;

clearRollupsForDevice:
DELETE FROM rollups WHERE device_id = ?;

selectControlState:
SELECT * FROM control_state WHERE control_key = ?;

upsertControlState:
INSERT OR REPLACE INTO control_state(control_key, device_id, device_seq, started_at_ms, utc_day, released)
VALUES (?, ?, ?, ?, ?, ?);

upsertLocalRollup:
INSERT OR REPLACE INTO rollups_local(device_id, day_local, app_key, total_ms, utc_offset_min, category)
VALUES (?, ?, ?, ?, ?, ?);

selectLocalRollups:
SELECT * FROM rollups_local WHERE device_id = ? AND day_local = ?;

deleteLocalRollupsForDay:
DELETE FROM rollups_local WHERE device_id = ? AND day_local = ?;
