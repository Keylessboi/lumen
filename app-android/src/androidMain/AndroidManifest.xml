<?xml version="1.0" encoding="utf-8"?>
<!-- app-android — OWNER: Agent A. M3 scaffold.
     allowBackup=false is LOCKED (docs/plan.md #10): Android auto-backup
     would exfiltrate the local DB to Google Drive in plaintext. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Usage Access: the ONLY permission lumen needs on Android.
         Not a runtime permission — user grants via Settings → Usage Access. -->
    <!-- Lint flags this as a system-app permission, and it is: it is
         signature|appop. Declaring it is nevertheless required and correct —
         it is what puts Lumen in the Usage Access list so the user can grant
         it there. Without the declaration the app cannot be granted access at
         all. Suppressed knowingly rather than by baseline, so the reason is
         next to the line. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Android 11+ package visibility: without a <queries> declaration the
         PackageManager only returns Lumen itself, system packages, and
         packages it has intent filters for. Every other installed app throws
         NameNotFoundException, so backfilled history renders as raw package
         names (com.foss.aihub) instead of labels ("AI Hub"). A screen-time
         tracker must resolve ANY app's label, so it must be visible to all
         launcher apps. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:label="Lumen"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
